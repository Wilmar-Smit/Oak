{
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": [
          "--compile-commands-dir=build/dev",
          "--query-driver=/nix/store/*-clang-wrapper-*/bin/*",
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=iwyu",
          "--function-arg-placeholders=true",
          "--pch-storage=memory",
        ],
      },
    },
  },
  "languages": {
    "C++": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": [
            "--style=file:.clang/.clang-format",
            "--assume-filename={buffer_path}",
          ],
        },
      },
    },
  },
  "dap": {
    "CodeLLDB": {
      "binary": "lldb-dap",
    },
  },
}
